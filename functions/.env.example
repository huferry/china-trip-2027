# Copy to .env (for main project) or .env.demo (for demo project deployment)
# Then set env vars before deploying functions:
#   firebase functions:config:set  (not needed for v2 — just use .env files)
# For Firebase Functions v2, place this file as:
#   functions/.env         → loaded by all deployments
#   functions/.env.demo    → loaded when deploying to "demo" project alias

# Anthropic API key (server-side only — never exposed to browser)
ANTHROPIC_API_KEY=

# Rate limit: max AI calls per user per hour (0 = unlimited)
# Set to 3 for demo, leave as 0 for main project
AI_RATE_LIMIT=0

# Claude model to use
# Main: claude-opus-4-6
# Demo: claude-haiku-4-5-20251001
AI_MODEL=claude-opus-4-6
