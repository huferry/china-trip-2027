# Demo mode environment — copy to .env.demo and fill in values from the chine-trip-demo Firebase project
VITE_DEMO_MODE=true

# Firebase config for the chine-trip-demo project
# Find these in Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=chine-trip-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=chine-trip-demo
VITE_FIREBASE_STORAGE_BUCKET=chine-trip-demo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_GOOGLE_TTS_KEY=

# Admin email
VITE_SUPERADMIN_EMAIL=huferry@gmail.com
