rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowed() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));
    }

    match /places/{document} {
      allow read: if isAllowed();
      allow create: if isAllowed();
      allow update, delete: if false;
    }

    match /allowedUsers/{email} {
      allow read: if request.auth != null;
      // Client may add itself when redeeming a valid, unused, non-expired invite
      allow create: if request.auth != null
        && request.auth.token.email == email
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data.usedBy == null
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data.expiresAt > request.time;
      allow update, delete: if false;
    }

    match /wishlists/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }

    match /invites/{token} {
      allow read: if request.auth != null;
      // Client may mark an invite as used (set usedBy + usedAt only)
      allow update: if request.auth != null
        && resource.data.usedBy == null
        && request.resource.data.usedBy == request.auth.token.email
        && request.resource.data.usedAt != null
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt;
      allow create, delete: if false;
    }
  }
}
